extends ../layouts/default.pug
include ../mixins/checkbox.pug

block main
  .card
    .card-header
      .row.align-items-center
        .col
          h4.card-title #{pageTitle}
    .card-body.pt-0
      form(id="accountAdminEditForm")
        .row
          .col-md-6.col-lg-6.d-none
            .mb-3
              label.form-label(for="id") id*
              input.form-control(id="id" type="text" name="id" value = recordDetail.id readonly)
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="fullName") Họ tên *
              input.form-control(id="fullName" type="text" name="fullName" value = recordDetail.fullName)
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="email") Email *
              input.form-control(id="email" type="email" name="email" value = recordDetail.email)
          .col-md-6.col-lg-6
            .mb-3
              label.form-label(for="status") Trạng thái
              select.form-select(id="status" name="status")
                option(value="initial" selected= (recordDetail.status == "initial")) Khởi tạo
                option(value="active" selected= (recordDetail.status == "active")) Hoạt động
                option(value="inactive" selected= (recordDetail.status == "inactive")) Tạm dừng
          .col-md-6.col-lg-6
            .mb-3
              div(form-group-file)
                label.form-label(for="avatar") Ảnh đại diện
                .input-group
                  span.btn.btn-outline-info(
                    btn-file-manager
                    data-bs-toggle="modal" 
                    data-bs-target="#modalFileManager"
                    ) Chọn file
                  input.form-control(id="avatar" type="text" name="avatar" input-file placeholder="Đường dẫn file..." value = recordDetail.avatar)
                .preview-file(preview-file)
                  img
          .col-md-6.col-lg-6
            .mb-3
              label.form-label Nhóm quyền
              div(class="checkbox-list" checkbox-list="roles")
                +checkbox(roleList, 0, recordDetail.roles)
        button.btn.btn-primary(type="submit") Cập nhật
        a.btn.btn-danger.ms-1(href=`/${pathAdmin}/account-admin/list`) Hủy
