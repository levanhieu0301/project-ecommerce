extends ../layouts/default.pug
include ../mixins/pagination.pug


block main
  if (permissionList.includes("product-attribute-trash"))
    .row
      .col-12
        .card
          .card-header
            .row.align-items-center
              .col
                h4.card-title #{pageTitle}
              // end col
              .col-auto
                a.btn.btn-info(
                  href=`/${pathAdmin}/product/attribute`
                  )
                  <i class="fa-solid fa-arrow-left me-1"></i>
                  | Quay lại danh sách
                  // end col
              // end col
            // end row
          // end card-header
          .card-body.pt-0
            .row
              .col-lg-6
                form.input-group.mb-3(form-search)
                  input.form-control(
                    placeholder="Từ khóa..."
                    type="text"
                    name="keyword"
                    )
                  button.btn.btn-secondary Tìm kiếm
            .table-responsive
              table.table.table-striped.mb-0
                thead.table-light
                  tr
                    th STT
                    th Tên thuộc tính
                    th Kiểu hiển thị
                    th Danh sách lựa chọn
                    th.text-end Hành động
                tbody
                  each item, index in listAttribute
                    tr
                      td #{pagination.skip + index + 1}
                      td #{item.name}
                      td #{item.type}
                      td
                        each option in item.options
                          span(class="badge bg-info me-1 mb-1") #{option.label}
                      td.text-end
                        a(
                          href="javascript:;"
                          btn-deleted
                          method="PATCH"
                          api=`/${pathAdmin}/product/attribute/undo/${item.id}`
                          class="me-1"
                          )
                          <i class="fa-solid fa-rotate-left"></i>
                        a(
                          href="javascript:;"
                          btn-deleted
                          method="DELETE"
                          api=`/${pathAdmin}/product/attribute/destroy/${item.id}`
                          )
                          <i class="fa-solid fa-trash text-danger"></i>
            +pagination()
      // end col
