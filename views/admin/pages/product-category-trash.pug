extends ../layouts/default.pug
include ../mixins/pagination.pug

block main
  if (permissionList.includes("product-category-trash"))
    .row
      .col-12
        .card
          .card-header
            .row.align-items-center
              .col
                h4.card-title #{pageTitle}
              // end col
              .col-auto
                a.btn.btn-primary(
                  href=`/${pathAdmin}/product/category` 
                  )
                  <i class="fa-solid fa-arrow-left me-1"></i>
                  | Quay lại danh mục sản phẩm
                  // end col
              // end col
            // end row
          // end card-header
          .card-body.pt-0
            .row
                .col-lg-6
                  form.input-group.mb-3(form-search)
                    input.form-control(
                      placeholder="Từ khóa..."
                      type="text"
                      name="keyword"
                      )
                    button.btn.btn-secondary Tìm kiếm
            .table-responsive
              table.table.table-striped.mb-0
                thead.table-light
                  tr
                    th STT
                    th Avatar
                    th Tên danh mục
                    th Danh mục cha
                    th Trạng thái
                    th Lượt xem
                    th.text-end Hành động
                tbody
                  each item, index in recordList
                    tr
                      td #{ index + 1}
                      td
                        if(item.avatar)
                          img(
                            src=`${domainCDN}${item.avatar}`
                            class="rounded thumb-md me-1 d-inline"
                          )
                      td #{item.name}
                      td #{item.parentName}
                      td
                        if (item.status == "active")
                          span(class="badge bg-success") Hoạt động
                        else if (item.status == "inactive")
                          span(class="badge bg-danger") Tạm dừng
                      td #{item.view}
                      td.text-end
                          a(
                            href="javascript:;"
                            btn-deleted
                            method="PATCH"
                            api=`/${pathAdmin}/product/category/undo/${item.id}`
                            class="me-1"
                            )
                            <i class="fa-solid fa-rotate-left"></i>
                          a(
                            href="javascript:;"
                            btn-deleted
                            method="DELETE"
                            api=`/${pathAdmin}/product/category/destroy/${item.id}`
                            )
                            <i class="fa-solid fa-trash text-danger"></i>
      // end col
