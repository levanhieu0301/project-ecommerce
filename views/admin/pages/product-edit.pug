extends ../layouts/default.pug
include ../mixins/checkbox.pug

block main
  if (permissionList.includes("product-edit"))
    .card
      .card-header
        .row.align-items-center
          .col
            h4.card-title #{pageTitle}
      .card-body.pt-0
        form(id="productEditForm")
          .row
            .col-md-6.col-lg-6.d-none
              .mb-3
                label.form-label(for="id") Id *
                input.form-control(id="id" type="text" name="id" value = recordProduct.id)
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="name") Tên sản phẩm *
                input.form-control(id="name" type="text" name="name"  value = recordProduct.name)
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="slug") Đường dẫn *
                .input-group
                  span.btn.btn-outline-info(
                    btn-generate-slug
                    model="Product" 
                    from="name"
                    to="slug"
                  ) Tự động
                  input.form-control(id="slug" type="text" name="slug"  value = recordProduct.slug)
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="position") Vị trí
                input.form-control(id="position" type="number" name="position"  value = recordProduct.position)
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="status") Trạng thái
                select.form-select(id="status" name="status")
                  option(value="draft" selected=(recordProduct.status == "draft")) Bản nháp
                  option(value="active" selected=(recordProduct.status == "active")) Hoạt động
                  option(value="inactive" selected=(recordProduct.status == "inactive")) Tạm dừng
            .col-md-6.col-lg-6
              .mb-3
                label.form-label Danh mục
                div(class="checkbox-list" checkbox-list="category")
                  +checkbox(categoryList, 0,recordProduct.category )
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="priceOld") Giá cũ
                input.form-control(id="priceOld" type="number" name="priceOld" value = recordProduct.priceOld)
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="priceNew") Giá mới
                input.form-control(id="priceNew" type="number" name="priceNew" value = recordProduct.priceNew)
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="stock") Còn lại
                input.form-control(id="stock" type="number" name="stock" value = recordProduct.stock)
            .col-md-12.col-lg-12
              .mb-3
                label.form-label Danh sách thuộc tính
                div(class="checkbox-list" checkbox-list="attributes" )
                  +checkbox(attributeList, 0, recordProduct.attributes)
                span.btn.btn-outline-info.mt-1(
                  button-render-variant="attributes"
                ) Tạo biến thể
                script. 
                  const attributeList = !{JSON.stringify(attributeList)}
            .col-md-12.col-lg-12
              .mb-3
                label.form-label Danh sách biến thể
                .table-responsive-sm
                  table.table.mb-0(table-variant)
                    thead.table-light
                      tr
                        th(scope="col") Trạng thái
                        each item in arrayNameAttri
                          th(scope="col") #{item}
                        th(scope="col") Giá cũ
                        th(scope="col") Giá mới
                        th(scope="col") Còn lại
                    tbody
                      each tr in recordProduct.variants
                        tr
                          td
                            .form-check.form-switch.form-switch-success
                              input.form-check-input(type="checkbox" checked=tr.status)
                            input(class="d-none" attribute-value value=tr.attributeValue)
                          each option in tr.attributeValue
                            td #{option.label}
                          td
                            input.form-control(type="number" value = tr.priceOld price-old)
                          td
                            input.form-control(type="number" value = tr.priceNew price-new)
                          td
                            input.form-control(type="number" value = tr.stock stock)
            .col-md-12.col-lg-12
              .mb-3
                label.form-label Danh sách ảnh
                div(class="form-multi-file")
                  .input-group
                    span.btn.btn-outline-info(
                      data-bs-toggle="modal"
                      data-bs-target="#modalFileManager"
                    ) Chọn file
                    span.btn.btn-outline-info(
                      button-paste
                    ) Dán file
                  .inner-list-image(multi-file="images")
                    each image in recordProduct.images
                      .inner-image
                        img(src=`${domainCDN}${image}` src-relative=`${image}`)
                        span.inner-remove x
                    //- .inner-image
                    //-   img(src="https://placehold.co/100x100/EEE/31343C", alt="")
                    //-   span.inner-remove x
            .col-md-12.col-lg-12
              .mb-3
                label.form-label(for="description") Mô tả ngắn
                textarea(id="description" name="description" textarea-mce) #{recordProduct.description}
            .col-md-12.col-lg-12
              .mb-3
                label.form-label(for="content") Nội dung chi tiết
                textarea(id="content" name="content" textarea-mce) #{recordProduct.content}
            .col-md-12.col-lg-12
              .mb-3
                label.form-label Tags
                select(select-tags name="tags" multiple taggable)
                  each tag in recordProduct.tags
                    option(value=tag selected) #{tag} 
            .col-md-12.col-lg-12
              .mb-3
                label.form-label Sản phẩm mua kèm
                select(select-tags name="boughtTogether" multiple taggable="false")
                  each item in productList
                    option(
                      value=item._id
                      selected=(recordProduct.boughtTogether.includes(item._id))
                      ) #{item.name}
          button.btn.btn-primary(type="submit") Cập nhật
          a.btn.btn-danger.ms-1(href=`/${pathAdmin}/product/list`) Hủy
