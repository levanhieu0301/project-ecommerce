extends ../layouts/default.pug
include ../mixins/pagination.pug

block main
  if (permissionList.includes("product-list"))
    .row
      .col-12
        .card
          .card-header
            .row.align-items-center
              .col
                h4.card-title #{pageTitle}
              // end col
              .col-auto
                if (permissionList.includes("product-trash"))
                  a.btn.btn-danger.me-1(
                    href=`/${pathAdmin}/product/trash`
                    )
                    i.las.la-trash-alt.me-1
                    | Thùng rác
                if (permissionList.includes("product-create"))
                  a.btn.btn-primary(
                    href=`/${pathAdmin}/product/create`
                    )
                    i.fa-solid.fa-plus.me-1
                    | Tạo sản phẩm
                  // end col
              // end col
            // end row
          // end card-header
          .card-body.pt-0
            .row
              .col-lg-6
                form.input-group.mb-3(form-search)
                  input.form-control(
                    placeholder="Từ khóa..."
                    type="text"
                    name="keyword"
                    )
                  button.btn.btn-secondary Tìm kiếm
            .table-responsive
              table.table.table-striped.mb-0
                thead.table-light
                  tr
                    th STT
                    th Avatar
                    th Tên sản phẩm
                    th Giá cũ (đ)
                    th Giá mới (đ)
                    th Còn lại
                    th Số biến thể
                    th Vị trí
                    th Trạng thái
                    th Lượt xem
                    th.text-end Hành động
                tbody
                  each item, index in recordList
                    tr
                      td #{index + 1}
                      td
                        if(item.images && item.images.length > 0)
                          img(
                            src=`${domainCDN}${item.images[0]}`
                            class="rounded thumb-md me-1 d-inline"
                          )
                      td #{item.name}
                      td
                        if(item.priceOld)
                          | #{item.priceOld.toLocaleString("vi-VN")}
                      td
                        if(item.priceNew)
                          | #{item.priceNew.toLocaleString("vi-VN")}
                      td #{item.stock}
                      td #{item.variants.length}
                      td #{item.position}
                      td
                        if (item.status == "draft")
                          span(class="badge bg-dark") Bản nháp
                        else if (item.status == "active")
                          span(class="badge bg-success") Hoạt động
                        else if (item.status == "inactive")
                          span(class="badge bg-danger") Tạm dừng
                      td #{item.view}
                      td.text-end
                        if (permissionList.includes("product-edit"))
                          a(href=`/${pathAdmin}/product/edit/${item.id}`)
                            i.las.la-pen.text-secondary.fs-20
                        if (permissionList.includes("product-delete"))
                          a(
                            href="javascript:;"
                            btn-deleted 
                            method="PATCH"
                            api=`/${pathAdmin}/product/delete/${item.id}` 
                          )
                            i.las.la-trash-alt.text-secondary.fs-20
            +pagination()
      // end col
