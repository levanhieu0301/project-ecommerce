extends ../layouts/default.pug
include ../mixins/pagination.pug

block main
  if (permissionList.includes("role-list"))
    .row
      .col-12
        .card
          .card-header
            .row.align-items-center
              .col
                h4.card-title #{pageTitle}
              // end col
              .col-auto
                if (permissionList.includes("role-trash"))
                  a.btn.btn-danger.me-1(
                    href=`/${pathAdmin}/role/trash`
                    )
                    i.las.la-trash-alt.me-1
                    | Thùng rác 
                if (permissionList.includes("role-create"))
                  a.btn.btn-primary(
                    href=`/${pathAdmin}/role/create`
                    )
                    i.fa-solid.fa-plus.me-1
                    | Tạo nhóm quyền
                  // end col
              // end col
            // end row
          // end card-header
          .card-body.pt-0
            .row
              .col-lg-6
                form.input-group.mb-3(form-search)
                  input.form-control(
                    placeholder="Từ khóa..."
                    type="text"
                    name="keyword"
                    )
                  button.btn.btn-secondary Tìm kiếm
            .table-responsive
              table.table.table-striped.mb-0
                thead.table-light
                  tr
                    th STT
                    th Tên nhóm quyền
                    th Mô tả
                    th Trạng thái
                    th.text-end Hành động
                tbody
                  each item, index in recordList
                    tr
                      td #{pagination.skip + index + 1}
                      td #{item.name}
                      td #{item.description}
                      td
                        if (item.status == "active")
                          span(class="badge bg-success") Hoạt động
                        else if (item.status == "inactive")
                          span(class="badge bg-danger") Tạm dừng
                      td.text-end
                        if (permissionList.includes("role-edit"))
                          a(href=`/${pathAdmin}/role/edit/${item.id}`)
                            i.las.la-pen.text-secondary.font-16
                        if (permissionList.includes("role-delete"))
                          a(
                            href="javascript:;"
                            btn-deleted 
                            method="PATCH"
                            api=`/${pathAdmin}/role/delete/${item.id}` 
                          )
                            i.las.la-trash-alt.text-secondary.font-16
            +pagination()
      // end col
