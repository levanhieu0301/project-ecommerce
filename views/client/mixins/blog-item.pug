mixin blog-item(blog)
  div(class="blog_item")
    a(
      class="blog_img" 
      href=`/article/detail/${blog.slug}`
      )
      img.img-fluid.w-100(
        alt="blog" 
        src= `${domainCDN}${blog.avatar}`
        )
    div(class="blog_text")
      ul.top
        if (blog.authorName)
          li
            span
              img.img-fluid.w-100(
                alt="user" 
                src="/client/assets/images/user_icon_black.svg"
                )
            | #{blog.authorName}
        if (blog.date)
          li
            span
              img.img-fluid.w-100(
                alt="Message" 
                src="/client/assets/images/calender.png"
                )
            | #{blog.date}
      a.title(href="blog_details.html")
        | #{blog.name}
      ul.bottom
        li
          a(href="blog_details.html")
            | Đọc thêm
            i.fas.fa-long-arrow-right
        li
          span
            i.far.fa-comment-dots
            | 0 Bình luận
