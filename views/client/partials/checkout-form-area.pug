form(class="checkout_form_area" id="checkoutForm")
  #accordionExample.accordion
    .accordion-item.border-0
      .accordion-header
        .accordion-button.collapsed.p-0(
          aria-controls="collapseThree" 
          aria-expanded="false" 
          data-bs-target="#collapseThree" 
          role="tabpanel" 
          data-bs-toggle="collapse"
          )
          .form-check
            input#flexCheckDefault.form-check-input(
              value=""
              name="userAddress" 
              type="radio"
              )
            label.form-check-label(for="flexCheckDefault") Thêm địa chỉ mới?
      #collapseThree.accordion-collapse.collapse(data-bs-parent="#accordionExample")
        .accordion-body.p-0
          .row
            .col-md-6
              div(class="single_input")
                label Họ và tên *
                input(
                  placeholder="Ví dụ: Nguyễn Văn A" 
                  type="text"
                  )
            .col-md-6
              div(class="single_input")
                label Số điện thoại *
                input(
                  placeholder="Ví dụ: 0123456789" 
                  type="text"
                  )
            .col-md-12.mt-4
              label Chọn địa chỉ trên bản đồ *
              div(class="input-group")
                input(
                  class="form-control" 
                  placeholder="Nhập địa chỉ cần tìm..." 
                  type="text"
                  id="mapSearchInput"
                  )
                span(
                  class="btn btn-outline-secondary"
                  id="mapSearchBtn"
                  ) Tìm kiếm
              div(id="boxMap" style="height: 350px; margin-bottom: 25px;")
            .col-md-6
              div(class="single_input")
                label(for="longitude") Kinh độ *
                input(type="text" name="longitude" id="longitude")
            .col-md-6
              div(class="single_input")
                label(for="latitude") Vĩ độ *
                input(type="text" name="latitude" id="latitude")
            .col-md-6
              div(class="single_input")
                label Địa chỉ
                input(
                  placeholder="Ví dụ: 123 Đường ABC, Quận XYZ" 
                  type="text"
                  name="address"
                  )
  .col-xl-12
    div(class="single_input")
      label Ghi chú
      textarea(
        rows="2"
        )
